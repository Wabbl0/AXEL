# Exclude large debug logs (up to 300+ MB) from indexing
logs/**

# Exclude any bundled JS files that may appear elsewhere
**/*bundle*.js

# Migration backups (duplicate agent transcripts, not runtime source)
tools/account_migration_backups/**

# Godot editor cache (regenerated on open)
AXEL/axel_project/.godot/**

# Godot sidecars (source of truth is .png, .gd, .tscn, etc.)
**/*.import
**/*.uid

# Python cache (tool scripts)
**/__pycache__/**
**/*.pyc

# Aseprite editor sources (runtime uses exported PNG)
**/*.aseprite

# Tool-generated previews / style sweeps (keep JSON drafts in scene_builder/output)
**/tools/visual_style/output/**
**/tools/scene_builder/output/layout_previews/**

# Archived QA run logs
AXEL/axel_project/plans/qa/archive/**

# Export captures + legacy port artifacts (narrative canon files stay indexed)
AXEL/axel_project/exports/**
!AXEL/axel_project/exports/game_data.json
!AXEL/axel_project/exports/GameManager.gd

# Legacy HTML prototype art (~83 MB) — @-mention when needed for narrative/scene look-dev
AXEL/html/pictures/**

# Archived agent changelog (historical; git is source of truth)
AXEL/axel_project/plans/core/archive/**

# Archived outdated plan docs (historical reference only)
AXEL/axel_project/plans/archive/**
