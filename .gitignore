# Cursor / local editor
.cursor/

# Godot editor binaries (large; keep out of git)
/Godot_v*.exe

# Logs
*.log

# Reference/export folders (large, non-runtime; not needed in version control)
/AXEL/axel_project/exports/
/AXEL/html/

# Local LimeZu icon clustering output (contact sheets + JSON)
/AXEL/axel_project/tools/combat/.icon_scan/

# QA capture output (regenerable PNGs from tools/qa/capture_scene.ps1)
/out/

# Dated leftover archive dumps that were already untracked at their old paths
AXEL/axel_project/archive/**/html/
AXEL/axel_project/archive/**/out/
AXEL/axel_project/archive/**/exports/
