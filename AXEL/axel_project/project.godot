; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AXEL"
run/main_scene="res://scenes/Main_Menu/0.1_MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

AxelSettings="*res://scripts/autoload/axel_settings.gd"
CombatPaceHost="*res://scripts/autoload/combat_pace.gd"
AxelCursor="*res://scripts/autoload/axel_cursor.gd"
AxelSaves="*res://scripts/autoload/axel_saves.gd"
GameManager="*res://exports/GameManager.gd"
AxelRun="*res://scripts/autoload/axel_run.gd"
AxelWorld="*res://scripts/autoload/axel_world.gd"
AxelPostFxStack="*res://scripts/autoload/axel_post_fx_stack.gd"
AxelEventFx="*res://scripts/autoload/axel_event_fx.gd"
AxelMusic="*res://scripts/autoload/axel_music.gd"
AxelSfx="*res://scripts/autoload/axel_sfx.gd"
AxelCombatDevTools="*res://scripts/debug/axel_combat_dev_tools.gd"
AxelPause="*res://scripts/autoload/axel_pause.gd"
AxelTutorial="*res://scripts/autoload/axel_tutorial.gd"

[debug]

shapes/collision/shape_color=Color(0, 0.92, 0.95, 0.42)
shapes/collision/contact_color=Color(0, 1, 0.5, 0.8)

[display]

window/size/viewport_width=1920
window/size/viewport_height=1280

